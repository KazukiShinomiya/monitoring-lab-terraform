<?xml version='1.0' encoding='utf-8'?>
<!--
  mrrules_local.xml - WOWHoneypot カスタムルール
  既存ルール(1001-1044)と重複しないよう 2001番から開始
  実際のアクセスログ(2020年〜)に出現した攻撃パターンを網羅
-->
<mrrs version='1.4'>

  <!-- ===== Git リポジトリ露出スキャン ===== -->
  <mrr>
    <meta>
      <mrrid>2001</mrrid>
      <enable>True</enable>
      <note>Git repository exposure scan - .git/HEAD</note>
    </meta>
    <trigger>
      <uri>\.git/</uri>
    </trigger>
    <response>
      <status>200</status>
      <body><![CDATA[ref: refs/heads/master]]></body>
    </response>
  </mrr>

  <!-- ===== ThinkPHP RCE ===== -->
  <mrr>
    <meta>
      <mrrid>2002</mrrid>
      <enable>True</enable>
      <note>ThinkPHP RCE - invokefunction</note>
    </meta>
    <trigger>
      <uri>invokefunction</uri>
    </trigger>
    <response>
      <status>200</status>
      <body><![CDATA[{"status":1,"info":"operation success","data":null}]]></body>
    </response>
  </mrr>

  <!-- ===== ThinkCMF RCE ===== -->
  <mrr>
    <meta>
      <mrrid>2003</mrrid>
      <enable>True</enable>
      <note>ThinkCMF RCE - fetch content</note>
    </meta>
    <trigger>
      <uri>fetch.*content.*php.*die</uri>
    </trigger>
    <response>
      <status>200</status>
      <body><![CDATA[HelloThinkCMF]]></body>
    </response>
  </mrr>

  <!-- ===== XDEBUG 悪用 ===== -->
  <mrr>
