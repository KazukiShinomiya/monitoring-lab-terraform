        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-RdYlGr",
            "fixedColor": "red",
            "seriesBy": "last"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
