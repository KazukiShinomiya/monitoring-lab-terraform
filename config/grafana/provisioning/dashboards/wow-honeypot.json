    {
      "id": 105,
      "title": "HTTP リクエスト数 (時系列) ※ログ処理タイミング基準",
      "description": "注意: このグラフはログの実際の攻撃タイムラインではなく、wow-exporterがログを処理したタイミングを示します。ログ同期(10分おき)の直後にスパイクが発生します。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(wowhoneypot_http_requests_total[20m])) * 60",
          "legendFormat": "総リクエスト数"
        },
        {
          "expr": "sum(rate(wowhoneypot_http_requests_total{matched=\"True\"}[20m])) * 60",
          "legendFormat": "攻撃マッチ数"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "攻撃マッチ数"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
