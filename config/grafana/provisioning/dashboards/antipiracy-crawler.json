{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "違法アップロード監視クローラーの稼働状況・検出件数・重複画像",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "title": "キュー待ちジョブ",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "crawler_queue_length or vector(0)", "legendFormat": "queued", "refId": "A"}
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 20}
            ]
          }
        }
      }
    },
    {
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "title": "24h 新規検出数",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "sum(increase(crawler_new_items_total[24h])) or vector(0)", "legendFormat": "items", "refId": "A"}
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "blue", "value": null}]
          }
        }
      }
    },
    {
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "title": "24h pHash 重複検出",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "sum(increase(crawler_phash_duplicates_total[24h])) or vector(0)", "legendFormat": "duplicates", "refId": "A"}
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 10}
            ]
          }
        }
      }
    },
    {
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "title": "24h エラーjob数",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "sum(increase(crawler_jobs_total{status=\"error\"}[24h])) or vector(0)", "legendFormat": "errors", "refId": "A"}
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 3},
              {"color": "red", "value": 10}
            ]
          }
        }
      }
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 5,
      "title": "新規検出件数（サイト別・時系列）",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "increase(crawler_new_items_total[1h])", "legendFormat": "{{site_name}}", "refId": "A"}
      ],
      "options": {"tooltip": {"mode": "multi"}},
      "fieldConfig": {
        "defaults": {"custom": {"lineWidth": 2, "fillOpacity": 10}}
      }
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 6,
      "title": "ジョブ結果（done / error）",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "increase(crawler_jobs_total{status=\"done\"}[1h])", "legendFormat": "done: {{site_name}}", "refId": "A"},
        {"expr": "increase(crawler_jobs_total{status=\"error\"}[1h])", "legendFormat": "error: {{site_name}}", "refId": "B"}
      ],
      "options": {"tooltip": {"mode": "multi"}}
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 7,
      "title": "ジョブ実行時間 p95（サイト別）",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(crawler_job_duration_seconds_bucket[1h]))",
          "legendFormat": "p95: {{site_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 8,
      "title": "pHash 近似重複検出（サイト別）",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "increase(crawler_phash_duplicates_total[1h])", "legendFormat": "{{site_name}}", "refId": "A"}
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 38,
  "tags": ["crawler", "antipiracy"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "timezone": "Asia/Tokyo",
  "title": "Antipiracy Crawler",
  "uid": "antipiracy-crawler",
  "version": 1
}
