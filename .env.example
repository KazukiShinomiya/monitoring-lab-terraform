# ==========================================
# Environment Variables Template
# ==========================================
# このファイルを .env にコピーして使用してください
# cp .env.example .env

# ----- Vault設定 -----
# Vault Root Token（開発モードでは "root" 固定）
VAULT_TOKEN=root

# Vaultサーバーアドレス（リモートサーバー上のVault）
VAULT_ADDR=http://YOUR_SERVER_IP:8200

# ----- データベース認証情報 -----
# PostgreSQL設定
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=zabbix

# ----- Grafana認証情報 -----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# ----- Zabbix認証情報 -----
ZABBIX_ADMIN_USER=Admin
ZABBIX_ADMIN_PASSWORD=your_zabbix_password_here
# Grafana の Zabbix データソースが API 認証に使うパスワード
# 未設定時は dev 既定 "zabbix" にフォールバック（terragrunt.hcl 側で定義）
ZABBIX_PASSWORD=your_zabbix_password_here

# ----- Zabbix外部スクリプト設定 -----
# SwitchBot API認証情報（SwitchBotアプリの開発者向けオプションから取得）
SWITCHBOT_TOKEN=YOUR_SWITCHBOT_TOKEN_HERE
SWITCHBOT_SECRET=YOUR_SWITCHBOT_SECRET_HERE
SWITCHBOT_TIMEOUT=10

# ----- プロジェクト設定 -----
PROJECT_NAME=monitoring-lab
ENVIRONMENT=local

# ----- Docker設定 -----
# WSL2環境では設定不要（デフォルトのUNIXソケットを使用）
# DOCKER_HOST=unix:///var/run/docker.sock

# Windows Docker Desktop（非WSL2）の場合は以下を使用
# DOCKER_HOST=npipe:////./pipe/docker_engine

# ----- Terraform設定 -----
# ログレベル（trace, debug, info, warn, error）
# 注意: 有効化するとSTDERR出力が増加します。通常はコメントアウト推奨
# TF_LOG=info

# Stateファイルの保存先（ローカル環境）
TF_STATE_DIR=.terraform-state

# ----- リモートサーバー設定 -----
# 構築対象サーバーのIPアドレスまたはホスト名
TARGET_HOST=your.remote.server.ip

# SSH接続ユーザー
TARGET_USER=ubuntu

# SSH接続ポート
TARGET_PORT=22

# SSH秘密鍵のパス（ローカルマシン上のパス）
SSH_PRIVATE_KEY=~/.ssh/monitoring_lab_key

# ----- 監視対象の実ホスト（sync-config.sh がデプロイ時にプレースホルダを置換） -----
# リポジトリの config/ は公開用にプレースホルダ化されている。
# ここが未設定のままだと sync-config.sh が配備を拒否する。
PROM_ROUTER_IP=192.168.x.x
PROM_NAS_IP=192.168.x.x
PROM_LINUX_HOST_1=192.168.x.x
PROM_LINUX_HOST_2=192.168.x.x
PROM_CRAWLER_HOST=192.168.x.x

# SSH鍵ディレクトリ（Docker Composeでマウントするディレクトリ）
# WSL2環境の場合: /mnt/c/Users/<username>/.ssh
# Linux環境の場合: ~/.ssh または /home/<username>/.ssh
SSH_KEYS_DIR=/mnt/c/Users/<your-username>/.ssh

# リモートサーバー上のデータ配置ディレクトリ
REMOTE_BASE_DIR=/home/ubuntu/monitoring-lab

# ----- New Relic設定 -----
# New Relic License Key（https://one.newrelic.com/admin-portal/api-keys/home から取得）
NEW_RELIC_LICENSE_KEY=YOUR_LICENSE_KEY_HERE

# New Relic Account ID（オプション、ダッシュボードURLから確認可能）
NEW_RELIC_ACCOUNT_ID=YOUR_ACCOUNT_ID

# New Relic Region（US or EU、デフォルト: US）
NEW_RELIC_REGION=US

# Infrastructure Agent表示名
NEW_RELIC_DISPLAY_NAME=monitoring-lab-docker-host

# ----- Alertmanager設定 -----
# Slack Incoming Webhook URL（https://api.slack.com/apps から取得）
# 注意: このURLは絶対にGitにコミットしないこと
# Vault から自動取得する場合は不要（VAULT_ADDR + VAULT_TOKEN が設定済みであれば省略可）
# SLACK_WEBHOOK_URL=<YOUR_SLACK_WEBHOOK_URL>

# ----- GitHub Actions Self-hosted Runner -----
# GitHub Personal Access Token（repo スコープ必須）
# 用途: self-hosted runner の自動登録・解除
# 取得: https://github.com/settings/tokens
GH_RUNNER_PAT=your_github_pat_here

# ----- 今後の拡張用 -----
# リモートStateバックエンド（S3使用時）
# AWS_REGION=ap-northeast-1
# S3_BUCKET=monitoring-lab-tfstate
# DYNAMODB_TABLE=monitoring-lab-tfstate-lock

# ----- セキュリティに関する注意 -----
# ⚠️ このファイルには機密情報が含まれる可能性があります
# ⚠️ .gitignore に .env を追加して、Gitにコミットしないでください
# ⚠️ 本番環境では環境変数管理ツール（AWS Secrets Manager など）の使用を推奨
