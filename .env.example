# ==========================================
# Environment Variables Template
# ==========================================
# このファイルを .env にコピーして使用してください
# cp .env.example .env

# ----- Vault設定 -----
# Vault Root Token（開発モードでは "root" 固定）
VAULT_TOKEN=root

# Vaultサーバーアドレス
VAULT_ADDR=http://localhost:8200

# ----- データベース認証情報 -----
# PostgreSQL設定
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD  # 本番環境では必ず変更
POSTGRES_DB=zabbix

# ----- Grafana認証情報 -----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin  # 本番環境では必ず変更

# ----- Zabbix認証情報 -----
ZABBIX_ADMIN_USER=Admin
ZABBIX_ADMIN_PASSWORD=zabbix  # 本番環境では必ず変更

# ----- プロジェクト設定 -----
PROJECT_NAME=monitoring-lab
ENVIRONMENT=local

# ----- Docker設定 -----
# Windows環境
DOCKER_HOST=npipe:////./pipe/docker_engine

# Linux/Mac環境の場合は以下をコメントアウト解除
# DOCKER_HOST=unix:///var/run/docker.sock

# ----- Terraform設定 -----
# ログレベル（trace, debug, info, warn, error）
TF_LOG=info

# Stateファイルの保存先（ローカル環境）
TF_STATE_DIR=.terraform-state

# ----- リモートサーバー設定 -----
# 構築対象サーバーのIPアドレスまたはホスト名
TARGET_HOST=YOUR_SERVER_IP

# SSH接続ユーザー
TARGET_USER=ubuntu

# SSH接続ポート
TARGET_PORT=22

# SSH秘密鍵のパス（ローカルマシン上のパス）
SSH_PRIVATE_KEY=~/.ssh/monitoring_lab_key

# リモートサーバー上のデータ配置ディレクトリ
REMOTE_BASE_DIR=/home/ubuntu/monitoring-lab

# ----- 今後の拡張用 -----
# リモートStateバックエンド（S3使用時）
# AWS_REGION=ap-northeast-1
# S3_BUCKET=monitoring-lab-tfstate
# DYNAMODB_TABLE=monitoring-lab-tfstate-lock

# ----- セキュリティに関する注意 -----
# ⚠️ このファイルには機密情報が含まれる可能性があります
# ⚠️ .gitignore に .env を追加して、Gitにコミットしないでください
# ⚠️ 本番環境では環境変数管理ツール（AWS Secrets Manager など）の使用を推奨
