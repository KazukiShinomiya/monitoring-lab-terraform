{
  "permissions": {
    "allow": [
      "mcp__docker__docker_list_containers",
      "mcp__docker__docker_get_logs",
      "mcp__docker__docker_get_stats",
      "mcp__prometheus__query_metrics",
      "mcp__prometheus__query_range",
      "mcp__prometheus__get_active_alerts",
      "mcp__prometheus__compare_metrics",
      "mcp__prometheus__list_proposals",
      "mcp__alertmanager__alertmanager_get_alerts",
      "mcp__alertmanager__alertmanager_list_silences",
      "mcp__terragrunt__list_workspaces",
      "mcp__terragrunt__get_service_config",
      "Bash(task tg:plan)",
      "Bash(task tg:plan:svc *)",
      "Bash(task slo:validate)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh secret list*)",
      "Bash(wsl -d Ubuntu-24.04 -e bash -c \"curl -s 'http://10.0.0.220:8428/api/v1/query'*)",
      "Bash(wsl -d Ubuntu-24.04 -e bash -c \"curl -s 'http://10.0.0.220:8428/api/v1/query_range'*)",
      "Bash(wsl -d Ubuntu-24.04 -e bash -c \"curl -s http://10.0.0.220:8428/api/v1/query*)",
      "Bash(wsl -d Ubuntu-24.04 -e bash -c \"curl -s http://10.0.0.220:9090/api/v1/*)",
      "Bash(wsl -d Ubuntu-24.04 -e bash -c \"curl -s 'http://10.0.0.220:9090/api/v1/*)",
      "Bash(wsl -d Ubuntu-24.04 -e bash -c \"curl -s http://10.0.0.220:3000/api/health*)",
      "Bash(wsl -d Ubuntu-24.04 -e bash -c \"curl -s http://10.0.0.220:9200/metrics*)",
      "Bash(wsl -d Ubuntu-24.04 -e bash -c \"ssh ubuntu@10.0.0.220 'docker ps*)",
      "Bash(wsl -d Ubuntu-24.04 -e bash -c \"ssh ubuntu@10.0.0.220 'docker logs*)",
      "Bash(wsl -d Ubuntu-24.04 -e bash -c \"ssh ubuntu@10.0.0.220 'docker inspect*)",
      "Bash(wsl -d Ubuntu-24.04 -e bash -c \"ssh ubuntu@10.0.0.220 'docker images*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "head -60 .claude/SESSION_STATE.md"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/check-tf-change.ps1"
          }
        ]
      }
    ]
  }
}
