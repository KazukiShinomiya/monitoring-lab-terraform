# ==========================================
# Git Ignore Configuration
# ==========================================

# ----- Terraform関連 -----
# Terraformのプラグインキャッシュ
.terraform/
.terraform.lock.hcl

# Stateファイル（機密情報を含む可能性）
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform-state/

# Terragruntのキャッシュ
.terragrunt-cache/

# 変数ファイル（機密情報を含む可能性）
*.tfvars
*.tfvars.json

# HCP Terraform / Terraform Cloud
# 認証情報ファイル（絶対にコミットしない）
.terraform.d/credentials.tfrc.json
.terraformrc
credentials.tfrc.json

# Terraform CLI設定（個人設定を含む可能性）
terraform.rc

# ----- 環境変数ファイル -----
.env
.env.local
.env.*.local

# ----- IDE/エディタ設定 -----
# Visual Studio Code
.vscode/
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws

# Vim
*.swp
*.swo
*~

# ----- OS関連 -----
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory

# ----- ログファイル -----
*.log
logs/
*.log.*

# ----- 一時ファイル -----
*.tmp
*.temp
*.bak
*.backup

# Claude Code 一時作業ディレクトリ
tmpclaude-*

# ----- Docker関連 -----
# docker-compose override（個人設定）
docker-compose.override.yml

# ----- GitHub Actions関連 -----
# ローカルテスト用ワークフローファイル
.github/workflows/*.local.yml

# act（GitHub Actionsローカル実行ツール）の設定
.actrc
.secrets

# GitHub Actions実行時の一時ファイル
.runner/

# ----- バックアップファイル -----
terraform-state-backup-*.tar.gz

# ----- AI Agent関連 -----
# settings.local.json はローカル専用パーミッション設定（Anthropicベストプラクティス）
# settings.json（プロジェクト共有）はコミット対象
.claude/settings.local.json
# セッション記録・スクリーンショット（ローカル専用）
.claude/SESSION_STATE.md
.claude/QUICKSTART_SESSION.md
.claude/sessions/
.claude/screenshots/
# キャラクター設定・個人情報（dotfilesで管理）
.claude/docs/persona.md

# Claude Code プロジェクト設定（キャラクター設定・個人ワークフローを含む）
CLAUDE.md
claude.md

# GitHub Spec Kit（仕様ファイルはコミット、一時ファイルは除外）
.specify/.cache/
.specify/*.tmp

# ----- MCP Server関連 -----
# .mcp.json は個人環境の絶対パスを含むためローカル専用（.mcp.json.example をテンプレートとして公開）
.mcp.json
# MCPデータストア（個人の監視データ・承認ログ）
.mcp-data/

# MCPサーバーのビルド成果物
mcp/*/dist/
mcp/*/node_modules/

# ----- その他 -----
# Node modules（もし使用する場合）
node_modules/

# Python環境（もし使用する場合）
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# ----- 許可するファイル -----
# テンプレートファイルは除外しない
!.env.example
!.mcp.json.example
!*.tfvars.example

# 016: mcp/*/src/telemetry.ts はビルド時に mcp/shared/telemetry.ts から同期される生成物（正本は shared）
mcp/*/src/telemetry.ts
