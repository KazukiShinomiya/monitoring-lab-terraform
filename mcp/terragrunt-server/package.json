{
  "name": "monitoring-lab-terragrunt-mcp",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "node -e \"const fs=require('fs');if(fs.existsSync('../shared/telemetry.ts'))fs.copyFileSync('../shared/telemetry.ts','src/telemetry.ts')\" && tsc",
    "start": "node dist/index.js",
    "test": "vitest run src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/uuid": "^11.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
