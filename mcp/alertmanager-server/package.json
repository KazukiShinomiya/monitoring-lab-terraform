{
  "name": "monitoring-lab-alertmanager-mcp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node -e \"const fs=require('fs');if(fs.existsSync('../shared/telemetry.ts'))fs.copyFileSync('../shared/telemetry.ts','src/telemetry.ts')\" && tsc",
    "start": "node dist/index.js",
    "test": "vitest run src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.207.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
